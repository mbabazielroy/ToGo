# ToGo mobile — connected mode configuration.
#
# The app's NORMAL entry point is CONNECTED mode (real Supabase auth + shared data).
# Set these two PUBLIC values so the app can reach the backend. Without them the app
# shows a "Setup needed" screen — it does NOT silently open demo mode.
#
# EXPO_PUBLIC_* variables are embedded in the app bundle at build time, so they are
# PUBLIC. Only ever use the Supabase project URL and the publishable/anon key here.
# NEVER put a service_role key or any privileged secret in an EXPO_PUBLIC_ var.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Development/test only: force the local demo prototype (fixtures, AsyncStorage,
# simulation controls). Leave UNSET for the normal connected app.
# EXPO_PUBLIC_TOGO_DEMO=1
