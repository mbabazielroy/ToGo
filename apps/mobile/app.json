{
  "expo": {
    "name": "ToGo",
    "slug": "togo-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "togo",
    "userInterfaceStyle": "light",
    "primaryColor": "#1f4d31",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.togo.mobile"
    },
    "android": {
      "package": "app.togo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1f4d31"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ToGo shows where you are on the map so you can find your nearest pickup hub. Your location stays on your phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1f4d31",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ToGo uses the camera only to scan passenger boarding QR codes at boarding."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "demoOnlyNote": "Illustrative pilot. No real transport service, partnerships, or payments."
    }
  }
}
