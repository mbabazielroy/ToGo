{
  "name": "togo-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "EXPO_PUBLIC_APP_VARIANT=passenger EXPO_PUBLIC_TOGO_DEMO=1 expo start",
    "preview:tunnel": "EXPO_PUBLIC_APP_VARIANT=passenger EXPO_PUBLIC_TOGO_DEMO=1 expo start --tunnel",
    "preview:web": "EXPO_PUBLIC_APP_VARIANT=passenger EXPO_PUBLIC_TOGO_DEMO=1 expo start --web",
    "preview:staff": "EXPO_PUBLIC_APP_VARIANT=staff EXPO_PUBLIC_TOGO_DEMO=1 expo start --port 8082",
    "preview:combined": "EXPO_PUBLIC_APP_VARIANT=combined EXPO_PUBLIC_TOGO_DEMO=1 expo start --port 8083",
    "e2e:build": "rm -rf dist-e2e && EXPO_PUBLIC_TOGO_DEMO=1 EXPO_PUBLIC_APP_VARIANT=passenger expo export --platform web --output-dir dist-e2e/passenger && EXPO_PUBLIC_TOGO_DEMO=1 EXPO_PUBLIC_APP_VARIANT=staff expo export --platform web --output-dir dist-e2e/staff && EXPO_PUBLIC_TOGO_DEMO=1 EXPO_PUBLIC_APP_VARIANT=combined expo export --platform web --output-dir dist-e2e/combined",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.65.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob@^13.0.0": "^14.0.4",
    "minimatch@^10.0.0": "^11.0.5",
    "uuid@^3.0.0": "^11.1.1"
  }
}
