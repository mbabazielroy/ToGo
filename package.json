{
  "name": "togo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ToGo \u2014 a virtual bus terminal for Uganda.",
  "scripts": {
    "dev": "vite",
    "build": "npm run legal && tsc -b && vite build",
    "legal": "node scripts/build-legal-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:test": "bash supabase/tests/run.sh",
    "db:concurrency": "bash supabase/tests/concurrency.sh",
    "backend:up": "bash scripts/local-backend.sh up",
    "backend:reset": "bash scripts/local-backend.sh reset",
    "backend:env": "bash scripts/local-backend.sh env",
    "backend:status": "bash scripts/local-backend.sh status",
    "backend:down": "bash scripts/local-backend.sh down"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.5"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
