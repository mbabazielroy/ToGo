# Website settings. Copy to `.env.local` for local development; set the same names
# on your web host (Vercel → Settings → Environment Variables) for deploys.
# Every value here is PUBLIC: it is built into the pages. NEVER put a Supabase
# service_role key in any of them.

# Operations console (/console): your Supabase project URL and publishable/anon key.
# Without them the console shows "Setup needed"; the info page works regardless.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Info page and legal pages. Use the same values as the phone app builds.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_LEGAL_NAME=
EXPO_PUBLIC_LEGAL_ADDRESS=
# Store links: until set, the page says the apps are coming soon.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
# Set if the apps use crash reporting, so the hosted privacy policy matches them.
EXPO_PUBLIC_SENTRY_DSN=
