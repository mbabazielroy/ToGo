# ToGo connected-mode configuration.
# Copy to `.env.local` and fill in with your Supabase project values.
#
# The app's NORMAL entry point is CONNECTED mode (real auth + shared data). With
# these set, the web app runs connected. WITHOUT them it shows a "Setup needed"
# screen — it does NOT silently open demo mode.
#
# Only the PUBLIC url and the publishable/anon key belong here — both are safe to
# ship to the browser. NEVER put a service_role key in any VITE_ variable: it would
# be bundled into the client and grant full database access to anyone.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Development/test only: force the local demo prototype. Leave UNSET for connected.
# VITE_TOGO_DEMO=1
