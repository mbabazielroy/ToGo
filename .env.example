# ToGo connected-mode configuration.
# Copy to `.env.local` and fill in with your Supabase project values.
#
# WITHOUT these, the app runs in fully-usable DEMO mode (local only).
# WITH them, the app runs in CONNECTED mode (real auth + shared data).
#
# Only the PUBLIC url and the publishable/anon key belong here — both are safe to
# ship to the browser. NEVER put a service_role key in any VITE_ variable: it would
# be bundled into the client and grant full database access to anyone.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
